# ===========================================
# 数据库配置 (Database Configuration)
# ===========================================

# 数据库主机地址 (Database host address)
# 示例: 127.0.0.1, localhost, db.example.com
DB_HOST=

# 数据库端口号 (Database port number)
# MySQL默认: 3306, PostgreSQL默认: 5432
DB_PORT=

# 数据库用户名 (Database username)
DB_USER=

# 数据库密码 (Database password)
DB_PASS=

# 数据库名称 (Database name)
DB_NAME=

# 数据库类型 (Database type)
# 支持的类型: mysql, pgsql, mssql, sqlite, oracle
DB_TYPE=

# 数据库连接字符串 (Database connection string)
# 可以直接使用连接字符串替代上面的单独配置
# PostgreSQL示例: postgres://username:password@host:port/database?sslmode=disable
# MySQL示例: username:password@tcp(host:port)/database?charset=utf8mb4&parseTime=True&loc=Local
#DB_LINK=postgres://lff:lff@:182.43.195.225:15432/kuaimk_beta?sslmode=disable
DB_LINK=postgres://kuaimk:Kuaimk23db@192.168.1.105:5432/kuaimk_beta?sslmode=disable

# 数据库额外参数 (Additional database parameters)
# 用于传递额外的数据库连接参数
DB_EXTRA=

# 数据库角色 (Database role for permission control)
# 用于权限控制的数据库角色
DB_ROLE=

# 是否开启调试模式 (Enable debug mode for SQL logging)
# true: 打印SQL语句到日志, false: 不打印
DB_DEBUG=true

# 数据库表前缀 (Database table prefix)
# 为所有表名添加前缀，例如: sys_
DB_PREFIX=

# 是否开启空跑模式 (Enable dry run mode)
# true: SQL语句不会真正执行，仅用于调试
DB_DRYRUN=

# 数据库权重 (Database weight for load balancing)
# 用于多数据库负载均衡时的权重设置
DB_WEIGHT=

# 数据库字符集 (Database charset)
# MySQL示例: utf8mb4, PostgreSQL示例: UTF8
DB_CHARSET=

# 数据库协议 (Database protocol)
# 数据库连接协议，通常为空使用默认值
DB_PROTOCOL=

# 数据库时区 (Database timezone)
# 示例: Asia/Shanghai, UTC, Local
DB_TIMEZONE=

# ===========================================
# 数据库连接池配置 (Connection Pool Configuration)
# ===========================================

# 最大空闲连接数 (Maximum idle connections in pool)
# 建议值: 10-50，根据应用并发量调整
# 设置过小会频繁创建连接，设置过大会占用过多资源
DB_MAX_IDLE_CONN_COUNT=

# 最大打开连接数 (Maximum open connections in pool)
# 建议值: 100-500，不要超过数据库服务器的最大连接数限制
# 需要根据服务器性能和并发需求调整
DB_MAX_OPEN_CONN_COUNT=

# 连接最大生存时间 (Maximum connection lifetime)
# 格式: "30s", "5m", "1h" 等
# 建议不超过数据库服务器的连接超时时间
# 设置合理的值可以避免长时间连接导致的问题
DB_MAX_CONN_LIFE_TIME=

# 空闲连接最大生存时间 (Maximum idle connection lifetime)
# 单位: 秒，建议设置为 10-300 秒
# 空闲连接超过此时间将被关闭，释放资源
DB_MAX_IDLE_LIFE_TIME=

# ===========================================
# 数据库操作超时配置 (Database Operation Timeouts)
# ===========================================

# 查询超时时间 (Query timeout duration)
# 格式: "30s", "1m", "5m" 等
# 为空则使用系统默认值，建议根据业务复杂度设置
DB_QUERY_TIMEOUT=

# 执行超时时间 (Execution timeout duration)
# 格式: "30s", "1m", "5m" 等
# 用于INSERT、UPDATE、DELETE等操作的超时控制
DB_EXEC_TIMEOUT=

# 事务超时时间 (Transaction timeout duration)
# 格式: "30s", "1m", "5m" 等
# 事务执行超过此时间将被回滚
DB_TRAN_TIMEOUT=

# 预处理语句超时时间 (Prepared statement timeout duration)
# 格式: "30s", "1m", "5m" 等
# 预处理语句的超时控制
DB_PREPARE_TIMEOUT=